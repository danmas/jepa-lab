# Веса моделей — воспроизводятся обучением (см. README, ~22 мин на CPU).
# Каждый чекпоинт ~5 МБ, в истории они не нужны.
out/*.pt

# Промежуточные эпизоды раскатки (пересобираются прогоном rollout)
out/*.episodes.jsonl

# Служебный мусор
__pycache__/
*.pyc
.pytest_cache/

# Логи (в т.ч. чужие, случайно попавшие в KB/)
logs/
KB/logs/
pg-mcp.log
*.log
rollout_expert.err

# Локальное окружение
.venv/
venv/
.env
